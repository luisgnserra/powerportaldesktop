# Distribution-only allowlist. Installer binaries belong in GitHub Release assets.
*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/DISTRIBUTION.md
!/SHA256SUMS.txt
!/release.json
!/install.ps1
!/docs/
/docs/*
!/docs/INSTALLATION.md
!/docs/CONFIGURATION.md
!/docs/USAGE.md
!/docs/TROUBLESHOOTING.md
!/docs/SCREENSHOTS.md
!/docs/RELEASING.md
!/docs/UPDATES.md
!/docs/images/
/docs/images/*
!/docs/images/powerbi-external-tools.png
!/docs/images/home.png
!/docs/images/connect-open-model.png
!/docs/images/live-model-data.png
!/docs/images/theme-generator.png
!/docs/images/calendar-generator.png
!/docs/images/components.png
!/docs/images/dax-formatter.png
!/docs/images/tv-tool.png
!/docs/images/performance-checklist.png
!/docs/images/contrast-calculator.png
!/docs/images/project-analyzer.png
!/docs/images/model-documenter.png
!/docs/images/measure-auditor.png
!/docs/images/consulting-training.png
!/docs/images/collapsed-sidebar.png
!/docs/images/update-available.png
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/installation.yml
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/distribution-check.yml
